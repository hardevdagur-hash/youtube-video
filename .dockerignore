# The Dockerfile copies an explicit list of application directories; this file keeps
# the build context small and guarantees secrets and local state never reach it.
.git
.github
.claude
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
.venv
venv
.ruff_cache
.pytest_cache
.vite
frontend/node_modules
frontend/dist
frontend/*.tsbuildinfo
data
logs
output
tmp
backups
docker
docs
tests
*.log
*.md
uv.lock
