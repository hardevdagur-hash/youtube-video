FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.25-alpine AS runtime

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

COPY --from=build --chown=appuser:appgroup /app/dist /usr/share/nginx/html

RUN chown -R appuser:appgroup /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown appuser:appgroup /var/run/nginx.pid

USER appuser

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

LABEL maintainer="devops@youtube-export-platform.com" \
      version="${IMAGE_TAG:-latest}" \
      description="YouTube Export Platform - React Frontend" \
      org.opencontainers.image.title="yt-export-frontend" \
      org.opencontainers.image.description="React frontend for YouTube Export & Transcript platform" \
      org.opencontainers.image.version="${IMAGE_TAG:-latest}" \
      org.opencontainers.image.source="https://github.com/yourorg/youtube-export-platform" \
      org.opencontainers.image.created=""

CMD ["nginx", "-g", "daemon off;"]
