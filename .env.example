# =============================================================================
# YouTube Transcript Service - configuration
#
# Copy to .env and fill in. Never commit .env. In Docker, docker-compose.yml
# passes this file to the app and fixes APP_ENV, DATA_DIR, LOG_TO_FILE and
# TRUSTED_PROXIES itself. Real environment variables override this file.
# Guided setup for the security values:
#   python scripts/configure_env.py --app-env production --origin https://<your-domain>
# =============================================================================

# --- Environment -------------------------------------------------------------
# Exactly "development" or "production"; production refuses unsafe settings.
APP_ENV=development

# --- YouTube Data API v3 (required) -------------------------------------------
# Google Cloud Console -> APIs & Services -> YouTube Data API v3 -> Credentials.
# Restrict the key to the YouTube Data API.
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Groq (speech-to-text fallback + Simple English / Simple Hindi) -----------
# https://console.groq.com/keys. Empty = videos without captions fail and only
# "Original Spoken" output is available.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TRANSLATION_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=3

# Speech-to-text fallback when a video has no captions.
WHISPER_ENABLED=true
# groq (hosted, production) | local (faster-whisper; needs extra ML packages, dev only)
STT_BACKEND=groq
# Longest video sent to speech-to-text, checked before any audio is downloaded (bounds
# Groq spend; Groq's free tier allows 7200 audio-seconds per hour).
STT_MAX_AUDIO_SECONDS=7200
# Audio over Groq's 25 MB upload limit (~45+ minutes) is split into chunks of this many
# seconds with ffmpeg (installed in the Docker image) and the results are merged.
STT_CHUNK_SECONDS=600
# Speech-to-text runs at once, server-wide (audio download + Groq upload each).
WHISPER_MAX_CONCURRENCY=1
# Seconds a request waits for a free speech-to-text slot before a retryable STT_BUSY.
STT_QUEUE_TIMEOUT_SECONDS=900
# Threads reserved for long transcript work (sign-in and health checks never wait for them).
TRANSCRIPT_WORKER_THREADS=8

# YouTube often blocks caption and audio requests from datacenter/cloud IPs (error code
# BOT_BLOCKED). Optional mitigations; test from the real server IP before relying on them.
# Egress proxy for YouTube traffic: http(s):// or socks5(h)://, credentials allowed (never logged).
YOUTUBE_PROXY_URL=
# Netscape-format cookies file for yt-dlp audio downloads (path inside the container/host).
YTDLP_COOKIES_FILE=

# --- Authentication -----------------------------------------------------------
# Session-cookie signing key, >= 32 random chars (required in production):
#   python scripts/hash_secret.py jwt-secret
JWT_SECRET_KEY=
# Browser users, comma-separated  username:role:scrypt-hash  (role: admin | user)
#   python scripts/hash_secret.py user alice --role admin
AUTH_USERS=
# API clients (X-API-Key header), comma-separated  name:role:sha256
#   python scripts/hash_secret.py apikey ci-bot --role user
API_KEYS=
SESSION_TTL_MINUTES=480

# --- Google sign-in ("Continue with Google", optional) ---------------------------
# Leave all empty to keep username/password only. Setup: docs/GOOGLE_SIGN_IN.md.
# OAuth "Web application" client from Google Cloud console > Google Auth Platform > Clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must equal an "Authorized redirect URI" of that client, path /api/auth/google/callback,
# on the same host the browser uses. Local Vite dev: http://localhost:5173/api/auth/google/callback
# Production: https://<your-domain>/api/auth/google/callback (https is required there).
GOOGLE_REDIRECT_URI=
# Who may sign up (at least one is required):
#   Google Workspace domains (comma-separated). The ID token's "hd" claim must equal one of
#   them; a personal Google account created on a company address (no "hd") is refused.
GOOGLE_ALLOWED_DOMAINS=
#   Personal Google accounts (no "hd" claim) by email domain, e.g. gmail.com. Must not
#   repeat a Workspace domain above. Empty = personal accounts are refused (secure default).
GOOGLE_ALLOWED_PERSONAL_EMAIL_DOMAINS=
#   ...or "true" to accept ANY verified Google account (anyone could use your API quota).
GOOGLE_ALLOW_ANY_ACCOUNT=false
# Google account ids ("sub", shown in DATA_DIR/users/google_users.json) that get the admin
# role. Everyone else who signs in with Google is a normal "user". Comma-separated.
GOOGLE_ADMIN_SUBJECTS=
# Google sign-in starts + callbacks per client IP per minute.
GOOGLE_AUTH_RATE_LIMIT_PER_MINUTE=20

# Extra browser origins allowed to call the API cross-origin (comma-separated).
# Empty is fine when the SPA is served by this app (the Docker setup). Never '*';
# production accepts https:// origins only. Local Vite dev: http://localhost:5173
CORS_ORIGINS=
# Proxy IPs whose X-Forwarded-For is trusted (set by docker-compose.yml in Docker).
TRUSTED_PROXIES=

# --- Abuse protection -----------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=300
# Transcript, channel and export requests (YouTube quota / Groq credits).
COSTLY_RATE_LIMIT_PER_MINUTE=20
# Login attempts per client IP, and per username across all IPs (bounds distributed guessing).
# Failures add a per-(IP, username) backoff instead of locking the account.
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_USER_RATE_LIMIT_PER_MINUTE=30
# Videos per background channel job / per synchronous channel request.
MAX_VIDEOS_PER_JOB=100
MAX_VIDEOS_SYNC_EXPORT=25
# Concurrent synchronous channel requests (server-wide).
MAX_CONCURRENT_SYNC_CHANNEL_RUNS=2
# Running background jobs: server-wide and per user.
MAX_ACTIVE_JOBS=4
MAX_ACTIVE_JOBS_PER_USER=2
# Channel runs process uploads with MIN <= duration < MAX seconds (default 3:00-30:00;
# single-video requests have no window). max_videos counts these eligible videos; at most
# CHANNEL_DISCOVERY_SCAN_CAP uploads are examined to find them (~2 YouTube units per 50).
CHANNEL_MIN_VIDEO_SECONDS=180
CHANNEL_MAX_VIDEO_SECONDS=1800
CHANNEL_DISCOVERY_SCAN_CAP=1000

# --- YouTube caption pacing ----------------------------------------------------
TRANSCRIPT_MAX_CONCURRENCY=1
TRANSCRIPT_REQUEST_INTERVAL=2.5
TRANSCRIPT_COOLDOWN_BASE=30
TRANSCRIPT_COOLDOWN_MAX=300
TRANSCRIPT_MAX_RETRIES=3

# --- Storage and job lifecycle ---------------------------------------------------
# Persistent data (jobs, transcript cache). Docker: /app/data on the transcript_data volume.
DATA_DIR=./data
# Finished/paused jobs untouched this long are deleted.
JOB_RETENTION_DAYS=30
# Finished jobs kept in memory for fast polling (others are read from disk).
JOB_MEMORY_CACHE_SIZE=8

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
# text (readable) | json (one object per line; the Docker image uses json)
LOG_FORMAT=text
# Docker logs to stdout only (LOG_TO_FILE=false is set by docker-compose.yml).
LOG_TO_FILE=true
LOG_DIR=./logs
