# =============================================================================
# YouTube Export Tool v3 — Environment Configuration
# =============================================================================

# --- REQUIRED: YouTube Data API ---
# Get your API key from Google Cloud Console: https://console.cloud.google.com/
# Enable the "YouTube Data API v3" for your project.
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- OPTIONAL: Speech-to-Text Fallback (Whisper API) ---
OPENAI_API_KEY=

# --- REQUIRED for STT Fallback & Translation: Groq API ---
# Get your API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TRANSLATION_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=3

LOG_LEVEL=INFO

# --- Redis Cache (optional — falls back to in-memory cache) ---
REDIS_URL=redis://localhost:6379/0

# --- YouTube API Limits ---
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_BATCH_SIZE=50
YOUTUBE_MAX_RESULTS=50
YOUTUBE_QUOTA_WARNING=8000

# --- Export Engine ---
EXPORT_MAX_VIDEOS=50000
EXPORT_TIMEOUT_MINUTES=30
EXPORT_CSV_BATCH_SIZE=50

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- Job size limits (each video can cost YouTube quota and STT credits) ---
MAX_VIDEOS_PER_JOB=1000
MAX_VIDEOS_SYNC_EXPORT=1000

# =============================================================================
# Security — authentication, sessions, CORS, rate limits
# Generate values with:  python scripts/hash_secret.py --help
# =============================================================================

# Exactly "development" or "production" (anything else refuses to start).
# Production refuses to start with unsafe settings.
APP_ENV=development

# Signs browser session cookies. Required in production (>= 32 random chars):
#   python scripts/hash_secret.py jwt-secret
JWT_SECRET_KEY=

# Browser logins, comma-separated  username:role:scrypt-hash   (role = admin | user)
#   python scripts/hash_secret.py user alice --role admin
AUTH_USERS=

# Programmatic clients (X-API-Key header), comma-separated  name:role:sha256
#   python scripts/hash_secret.py apikey ci-bot --role user
API_KEYS=

SESSION_TTL_MINUTES=480

# Extra browser origins allowed to call the API (comma-separated). Leave empty when
# the SPA is served by this app (same origin). Never '*' in production.
# Local Vite dev server: http://localhost:5173
# Production: https:// origins only, e.g. https://<your-real-domain>
CORS_ORIGINS=

# Reverse-proxy IPs whose X-Forwarded-For header is trusted for client IPs
TRUSTED_PROXIES=

# Per-principal request budgets
API_RATE_LIMIT_PER_MINUTE=300
COSTLY_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=5
