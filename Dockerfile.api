FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY . .
RUN find . -type d \( -name "__pycache__" -o -name ".git" -o -name "node_modules" -o -name "tests" -o -name "venv" -o -name ".venv" -o -name "frontend" \) -prune -exec rm -rf {} + 2>/dev/null; \
    find . -type f \( -name "*.pyc" -o -name "*.pyo" -o -name "*.egg-info" -o -name "*.egg" \) -delete

FROM python:3.11-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser --gid 1000 && \
    useradd -r -g appuser --uid 1000 -m -d /app appuser

COPY --from=builder --chown=appuser:appuser /app /app

WORKDIR /app

USER appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=production \
    LOG_LEVEL=INFO

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

LABEL maintainer="devops@youtube-export-platform.com" \
      version="${IMAGE_TAG:-latest}" \
      description="YouTube Export Platform - FastAPI Backend" \
      org.opencontainers.image.title="yt-export-api" \
      org.opencontainers.image.description="FastAPI backend for YouTube Export & Transcript platform" \
      org.opencontainers.image.version="${IMAGE_TAG:-latest}" \
      org.opencontainers.image.source="https://github.com/yourorg/youtube-export-platform" \
      org.opencontainers.image.created=""

CMD ["uvicorn", "webapp.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--proxy-headers", "--forwarded-allow-ips=*"]

