# syntax=docker/dockerfile:1.7
# =============================================================================
# YouTube Export Tool — production image (API + built SPA in one container)
#
#   docker build -f Dockerfile.api -t yt-export:local .
#
# Runs exactly ONE uvicorn worker: job progress, rate limits, login lockout and the
# YouTube quota counter are held in process memory (see DEPLOYMENT.md). Scale up the
# machine, not the worker count. TLS and client-IP forwarding are handled by the
# reverse proxy in deploy/ (TRUSTED_PROXIES), never by uvicorn --proxy-headers.
# =============================================================================

# ---- 1. Frontend build -------------------------------------------------------
FROM node:24-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build \
    && find dist -name '*.map' -delete

# ---- 2. Python dependencies (hash-pinned) -----------------------------------
FROM python:3.12-slim-bookworm AS pydeps
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
COPY requirements.lock ./
RUN /opt/venv/bin/pip install --require-hashes --no-deps -r requirements.lock \
    && /opt/venv/bin/pip check

# ---- 3. Runtime --------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1000 appuser \
    && useradd --system --uid 1000 --gid appuser --home-dir /app --shell /usr/sbin/nologin appuser

WORKDIR /app
COPY --from=pydeps /opt/venv /opt/venv
COPY --chown=appuser:appuser . /app
COPY --from=frontend --chown=appuser:appuser /build/dist /app/frontend/dist

# Writable state; mounted as volumes in deploy/docker-compose.prod.yml.
RUN mkdir -p webapp/runs data/transcripts data/transcript_jobs output logs tmp/audio \
    && chown -R appuser:appuser webapp/runs data output logs tmp

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=production \
    WEB_CONCURRENCY=1 \
    WHISPER_ENABLED=false \
    LOG_LEVEL=INFO

USER appuser
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"]

LABEL org.opencontainers.image.title="yt-export" \
      org.opencontainers.image.description="YouTube Export & Transcript tool (FastAPI + React SPA)"

CMD ["uvicorn", "webapp.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--no-server-header", "--timeout-graceful-shutdown", "30"]
